# 生产环境模板。复制为 .env.production 后填写全部变量；实际文件不会提交到 Git。
IM_OPENCHAT_USER_URL=
IM_BIZ_URL=
IM_CHAT_HOST=
IM_CHAT_PORT=
IM_VERSION_SECRET_NAME=
IM_BODY_AES_KEY=
IM_HEADER_AES_KEY=
IM_APP_VER=
IM_PACKAGE_CODE=
IM_PLAT=
IM_LANGUAGE=
IM_SYS_MODEL=
# IM_SYS_MAC 可选：设置后优先使用；不设置则由应用首次启动时生成并持久化到 ~/.im-monitor/sys_mac，
# 保证同一设备重装后设备标识不变。服务端按此标识绑定账号，不可随意变更。
# IM_SYS_MAC=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# 开奖匹配模式（可选）：issue=默认，开奖+期号匹配；uid=开奖+发信人UID范围匹配
# IM_LOTTERY_MATCH_MODE=
# IM_LOTTERY_MATCH_UID_START=
# IM_LOTTERY_MATCH_UID_END=
VITE_GT4_CAPTCHA_ID=
